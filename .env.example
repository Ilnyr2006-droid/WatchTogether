WATCHTOGETHER_PORT=47821
HOSTNAME=0.0.0.0
# Absolute folder on the Host PC. Windows example: D:\Movies
WATCHTOGETHER_MEDIA_DIR=
# Preferred public HTTPS address created by Caddy, without a trailing slash.
WATCHTOGETHER_PUBLIC_URL=
# Usually the same HTTPS origin as WATCHTOGETHER_PUBLIC_URL.
ALLOWED_ORIGIN=
# STUN stays available as a fallback when TURN is not configured/reachable.
STUN_URL=stun:stun.l.google.com:19302
# Production TURN. TURN_SECRET must match coturn static-auth-secret and stay server-side.
TURN_URL=
TURN_SECRET=
TURN_TTL=3600
# Build-time flag. Shows WebRTC stats; do not normally enable for end users.
NEXT_PUBLIC_WEBRTC_DEBUG=false
# Used by the optional docker-compose.turn.yml coturn service.
TURN_REALM=watch.example.com
TURN_EXTERNAL_IP=
